# Plantilla de variables de entorno para Habit Challenge API
# Copia este archivo como .env y personaliza los valores

# ======================
# CONFIGURACIÓN JWT
# ======================
# Clave secreta para firmar tokens JWT (cambia en producción)
SECRET_KEY=change-this-secret-key-in-production-must-be-at-least-32-characters-long

# Algoritmo de encriptación para JWT
ALGORITHM=HS256

# Tiempo de expiración del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================
# CONFIGURACIÓN DE BASE DE DATOS
# ======================
# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql://miguel:123@localhost:5432/habit

# ======================
# API DEL CLIMA
# ======================
# API Key de OpenWeatherMap (gratuita)
# Regístrate en: https://openweathermap.org/api
# Permite hasta 1,000 llamadas/día gratis
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ======================
# CONFIGURACIÓN DE APLICACIÓN
# ======================
# Nombre de la aplicación
APP_NAME="Habit Challenge API"

# Modo debug (true para desarrollo, false para producción)
DEBUG=true

# ======================
# CONFIGURACIÓN ADICIONAL OPCIONAL
# ======================
# Puerto en el que correr la aplicación (por defecto 8000)
# PORT=8000

# Host en el que correr la aplicación (por defecto 0.0.0.0)
# HOST=0.0.0.0

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# ======================
# NOTAS IMPORTANTES
# ======================
# 1. NUNCA commits el archivo .env a git (está en .gitignore)
# 2. En producción, usa variables de entorno del sistema
# 3. La SECRET_KEY debe ser única y segura en producción
# 4. Para PostgreSQL local, puedes usar Docker:
#    docker run --name postgres-habit -e POSTGRES_PASSWORD=123 -e POSTGRES_USER=miguel -e POSTGRES_DB=habit -p 5432:5432 -d postgres
# 5. La API key de OpenWeather es opcional pero recomendada para clima automático
