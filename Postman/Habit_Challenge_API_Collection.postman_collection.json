          ]
        },
        {
          "name": "3. Crear Hábito - Pasos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Meta Diaria de Pasos\",\n  \"description\": \"Caminar 10,000 pasos todos los días\",\n  \"activity_type\": \"pasos\",\n  \"is_public\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/habits/",
              "host": ["{{base_url}}"],
              "path": ["habits", ""]
            },
            "description": "Crea un nuevo hábito para conteo de pasos"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Hábito de pasos creado exitosamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('habit_steps_id', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Listar Mis Hábitos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/habits/me",
              "host": ["{{base_url}}"],
              "path": ["habits", "me"]
            },
            "description": "Obtiene todos los hábitos del usuario actual"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lista de hábitos obtenida', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Contiene hábitos creados', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.be.an('array');",
                  "    pm.expect(response.length).to.be.at.least(3);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Obtener Hábito por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/habits/{{habit_running_id}}",
              "host": ["{{base_url}}"],
              "path": ["habits", "{{habit_running_id}}"]
            },
            "description": "Obtiene detalles de un hábito específico"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Hábito obtenido exitosamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Datos del hábito correctos', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.id).to.eql(parseInt(pm.environment.get('habit_running_id')));",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Operaciones CRUD para gestión de hábitos de actividades físicas"
    },
    {
      "name": "📊 Seguimiento de Progreso",
      "item": [
        {
          "name": "1. Registrar Sesión de Running",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"habit_id\": {{habit_running_id}},\n  \"date\": \"{{current_date}}\",\n  \"distance_km\": 5.2,\n  \"duration_minutes\": 32,\n  \"city\": \"Madrid\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/progress/",
              "host": ["{{base_url}}"],
              "path": ["progress", ""]
            },
            "description": "Registra una sesión de running con datos del clima automáticos"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Progreso de running registrado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Pace calculado automáticamente', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('pace');",
                  "    pm.expect(response.pace).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Datos del clima incluidos', function () {",
                  "    const response = pm.response.json();",
                  "    // El clima puede fallar, pero los campos deben existir",
                  "    pm.expect(response).to.have.property('weather_temperature');",
                  "    pm.expect(response).to.have.property('weather_description');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Registrar Caminata",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"habit_id\": {{habit_walking_id}},\n  \"date\": \"{{current_date}}\",\n  \"distance_km\": 3.8,\n  \"duration_minutes\": 45,\n  \"city\": \"Barcelona\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/progress/",
              "host": ["{{base_url}}"],
              "path": ["progress", ""]
            },
            "description": "Registra una sesión de caminata"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Progreso de caminata registrado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Datos específicos de caminata', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.distance_km).to.eql(3.8);",
                  "    pm.expect(response.duration_minutes).to.eql(45);",
                  "    pm.expect(response.city).to.eql('Barcelona');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Registrar Pasos Diarios",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"habit_id\": {{habit_steps_id}},\n  \"date\": \"{{current_date}}\",\n  \"steps\": 12500\n}"
            },
            "url": {
              "raw": "{{base_url}}/progress/",
              "host": ["{{base_url}}"],
              "path": ["progress", ""]
            },
            "description": "Registra el conteo de pasos del día"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pasos registrados exitosamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Solo campos de pasos presentes', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.steps).to.eql(12500);",
                  "    pm.expect(response.distance_km).to.be.null;",
                  "    pm.expect(response.duration_minutes).to.be.null;",
                  "    pm.expect(response.city).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Ver Mi Progreso",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/me",
              "host": ["{{base_url}}"],
              "path": ["progress", "me"]
            },
            "description": "Obtiene todo el progreso del usuario"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Progreso obtenido exitosamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Contiene registros de progreso', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.be.an('array');",
                  "    pm.expect(response.length).to.be.at.least(3);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Progreso por Hábito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/habit/{{habit_running_id}}",
              "host": ["{{base_url}}"],
              "path": ["progress", "habit", "{{habit_running_id}}"]
            },
            "description": "Obtiene progreso específico de un hábito"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Progreso del hábito obtenido', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Todos los registros pertenecen al hábito', function () {",
                  "    const response = pm.response.json();",
                  "    const habitId = parseInt(pm.environment.get('habit_running_id'));",
                  "    response.forEach(record => {",
                  "        pm.expect(record.habit_id).to.eql(habitId);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Endpoints para registrar y consultar progreso de actividades físicas"
    },
    {
      "name": "📈 Estadísticas y Resúmenes",
      "item": [
        {
          "name": "1. Resumen Semanal - Correr",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/summary/?days=7&activity_type=correr",
              "host": ["{{base_url}}"],
              "path": ["progress", "summary", ""],
              "query": [
                {
                  "key": "days",
                  "value": "7"
                },
                {
                  "key": "activity_type",
                  "value": "correr"
                }
              ]
            },
            "description": "Obtiene resumen de actividades de correr en los últimos 7 días"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resumen de running obtenido', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Contiene estadísticas de running', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('activity_type');",
                  "    pm.expect(response).to.have.property('total_distance_km');",
