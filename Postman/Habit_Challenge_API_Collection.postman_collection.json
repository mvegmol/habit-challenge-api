{
  "info": {
    "name": "Habit Challenge API - Physical Activities",
    "description": "Colección completa para probar la API de seguimiento de actividades físicas (correr, caminar, pasos) con integración del clima.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Configuración automática de variables",
          "if (!pm.environment.get('base_url')) {",
          "    pm.environment.set('base_url', 'http://localhost:8000');",
          "}",
          "",
          "// Auto-setup de fecha actual",
          "pm.environment.set('current_date', new Date().toISOString().split('T')[0]);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "habit_running_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "habit_walking_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "habit_steps_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "current_date",
      "value": "2025-08-03",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Autenticación",
      "item": [
        {
          "name": "1. Registrar Usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"runner@example.com\",\n  \"password\": \"StrongPassword123\",\n  \"full_name\": \"María Runner\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Registra un nuevo usuario en el sistema"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario registrado exitosamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Respuesta contiene datos del usuario', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('id');",
                  "    pm.expect(response).to.have.property('email');",
                  "    pm.expect(response).to.have.property('created_at');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('user_id', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Iniciar Sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"runner@example.com\",\n  \"password\": \"StrongPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica al usuario y obtiene token JWT"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Token recibido', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('access_token');",
                  "    pm.expect(response).to.have.property('token_type');",
                  "    pm.expect(response.token_type).to.eql('bearer');",
                  "});",
                  "",
                  "// Guardar token automáticamente",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('auth_token', response.access_token);",
                  "    console.log('Token guardado automáticamente');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Obtener Perfil Actual",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Obtiene información del usuario autenticado"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Perfil obtenido exitosamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Datos del perfil válidos', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('email');",
                  "    pm.expect(response).to.have.property('full_name');",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Endpoints para registro, login y gestión de sesiones"
    },
    {
      "name": "🏃‍♂️ Gestión de Hábitos",
      "item": [
        {
          "name": "1. Crear Hábito - Correr",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Running Matutino\",\n  \"description\": \"Sesión de correr todas las mañanas para mantenerme en forma\",\n  \"activity_type\": \"correr\",\n  \"is_public\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/habits/",
              "host": ["{{base_url}}"],
              "path": ["habits", ""]
            },
            "description": "Crea un nuevo hábito para actividad de correr"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Hábito de correr creado exitosamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Datos del hábito válidos', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('id');",
                  "    pm.expect(response.activity_type).to.eql('correr');",
                  "    pm.expect(response.title).to.eql('Running Matutino');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('habit_running_id', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Crear Hábito - Caminar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Caminata Vespertina\",\n  \"description\": \"Caminar por el parque después del trabajo\",\n  \"activity_type\": \"caminar\",\n  \"is_public\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/habits/",
              "host": ["{{base_url}}"],
              "path": ["habits", ""]
            },
            "description": "Crea un nuevo hábito para actividad de caminar"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Hábito de caminar creado exitosamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
