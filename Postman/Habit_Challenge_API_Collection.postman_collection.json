                ]
              }
            }
          ]
        },
        {
          "name": "3. Resumen de Pasos - 2 Semanas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/progress/summary/?days=14&activity_type=pasos",
              "host": ["{{base_url}}"],
              "path": ["progress", "summary", ""],
              "query": [
                {
                  "key": "days",
                  "value": "14"
                },
                {
                  "key": "activity_type",
                  "value": "pasos"
                }
              ]
            },
            "description": "Obtiene resumen de pasos en las últimas 2 semanas"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resumen de pasos obtenido', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Estructura específica para pasos', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('activity_type');",
                  "    pm.expect(response).to.have.property('total_steps');",
                  "    pm.expect(response).to.have.property('days');",
                  "    pm.expect(response.activity_type).to.eql('pasos');",
                  "    // No debe tener campos de running/walking",
                  "    pm.expect(response).to.not.have.property('total_distance_km');",
                  "    pm.expect(response).to.not.have.property('average_pace');",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Endpoints para obtener estadísticas y resúmenes de actividades"
    },
    {
      "name": "❌ Casos de Error y Validación",
      "item": [
        {
          "name": "1. Error - Actividad sin campos requeridos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"habit_id\": {{habit_running_id}},\n  \"date\": \"{{current_date}}\",\n  \"distance_km\": 5.0\n  // Falta duration_minutes y city\n}"
            },
            "url": {
